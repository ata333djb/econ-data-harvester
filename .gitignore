# ---------------------------------------------------------------------------
# EconDataHarvester
# ---------------------------------------------------------------------------

# Virtual environment and the project-local Python toolchain that backs it
.venv/
.tools/

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.bak
*.bak-*

# Node
node_modules/
node-compile-cache/

# Harvest outputs: the directories are tracked, their contents are not.
# Ignoring a directory's CONTENTS (rather than the directory) is what lets the
# .gitkeep files below be re-included and keeps the folder layout in the repo.
data/raw/*
data/parsed/*
data/validated/*
data/processed/*
data/output/*
output/*
!data/**/.gitkeep
!output/.gitkeep

# Packaging output: the distributable is a zip, not a tracked tree
dist/

# Local scratch used by the exporter self-test. It deliberately writes to a
# fixed workspace path instead of the system temp dir -- see
# docs/ENGINEERING_NOTES.md section 3.7 for why.
.exporter-selftest/

# DSH agent-harness session state and presets.
# The .dsh/ folder wires this project into the harness the original author used.
# It hardcodes absolute paths to their machine and is meaningless elsewhere, so
# it is deliberately NOT part of the public repository. tools/verify-preset.mjs
# and the .dsh folder are optional extras -- see README "Optional: agent harness".
.dsh/
.dsh-scratch/

# Misc scratch
.pip-tmp/
.tmp-pip/
tmpgb9sfm6l/
