# Virtual environment and the project-local Python toolchain that backs it
.venv/
.tools/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Node
node_modules/

# Harvest outputs: the directories are tracked, their contents are not.
# Ignoring a directory's contents (rather than the directory) is what lets the
# .gitkeep files below be re-included.
data/raw/*
data/parsed/*
data/validated/*
data/processed/*
data/output/*
output/*
!data/**/.gitkeep
!output/.gitkeep

# DSH session state, if one is ever booted with this project as its home
.dsh/sessions/
.dsh/storages/

# 杩藉姞锛氫复鏃剁洰褰曚笌缂撳瓨
.pip-tmp/
.tmp-pip/
tmpgb9sfm6l/
.dsh-scratch/

# 澶囦唤鏂囦欢
*.bak
*.bak-*

# Node 缂栬瘧缂撳瓨
node-compile-cache/

# Python 缂撳瓨
__pycache__/
*.pyc

# 打包产物：只打 zip 分发，不进 git
dist/
.exporter-selftest/
